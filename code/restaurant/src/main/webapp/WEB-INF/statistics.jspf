<%@ page pageEncoding="UTF-8" %>
<%-- [NGOÀI THIẾT KẾ] Tiện ích trình bày và đọc tham số cho module thống kê (Hình 6).
 Không tạo thuộc tính request/session, không truy vấn hay thêm nghiệp vụ. --%>
<%!
private java.util.Date day(String value) {
    try { return java.sql.Date.valueOf(java.time.LocalDate.parse(value)); }
    catch (java.time.DateTimeException | IllegalArgumentException e) { return null; }
}
private int id(String value) {
    try { int result=Integer.parseInt(value); return result>=0 ? result : -1; }
    catch (NumberFormatException e) { return -1; }
}
private String q(Object value) { return java.net.URLEncoder.encode(value==null ? "" : value.toString(),java.nio.charset.StandardCharsets.UTF_8); }
private String money(float value) { return java.text.NumberFormat.getNumberInstance(java.util.Locale.forLanguageTag("vi-VN")).format(value); }
private String date(java.util.Date value) { return value==null ? "" : new java.text.SimpleDateFormat("dd/MM/yyyy").format(value); }
private String time(java.util.Date value) { return value==null ? "" : new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(value); }
private java.util.Date paidAt(Invoice4 invoice) {
    java.util.Date first=null;
    for(Payment4 payment:invoice.getPayments()) if("Thành công".equals(payment.getResult()) && (first==null || payment.getPaidAt().before(first))) first=payment.getPaidAt();
    return first;
}
%>
